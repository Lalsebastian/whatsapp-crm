# Home Services WhatsApp Chatbot — environment variables.
#
# Backend vars below go in api/.env (the Express server's working directory).
# Frontend vars (VITE_*) go in a .env file at the repo root, next to
# vite.config.js — Vite only exposes VITE_-prefixed vars to client code.
# Never commit either real .env file.

# ── AI (Google Gemini) ─────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────
# New names. WHATSAPP_TOKEN / VERIFY_TOKEN (the pre-refactor names) still work
# as fallbacks during the transition — see api/config/env.js.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Client CRM (placeholder until the client documents their real API) ────
CLIENT_API_BASE_URL=
CLIENT_API_KEY=
# supabase = use the built-in Supabase-backed CRM adapter (default, works today)
# http     = use httpCrmAdapter.js against CLIENT_API_BASE_URL (not implemented yet)
CRM_PROVIDER=supabase

# ── Chatbot reliability ─────────────────────────────────────────────────
CRM_REQUEST_TIMEOUT_MS=10000
AI_REQUEST_TIMEOUT_MS=10000
WHATSAPP_REQUEST_TIMEOUT_MS=10000
SESSION_TTL_MINUTES=60
MAX_READ_RETRIES=2
WHATSAPP_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=250
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_COOLDOWN_MS=30000

# ── WhatsApp voice notes ────────────────────────────────────────────────
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_MAX_FILE_SIZE_MB=10
VOICE_TRANSCRIPTION_TIMEOUT_MS=20000
VOICE_MIN_CONFIDENCE=0.55

# ── Supabase (datastore for sessions/customers/bookings/complaints/etc.) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only, never expose to the browser. Falls back to
# SUPABASE_ANON_KEY when unset. Set this before enabling RLS, otherwise the
# webhook loses access to every table.
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Authorized developer test console ───────────────────────────────────
# Both values are required. Send the secret in the x-test-chat-secret header.
ENABLE_TEST_CHAT=false
TEST_CHAT_SECRET=

# ── Frontend dashboard (root .env, not api/.env — Vite requires VITE_ prefix) ─
VITE_SUPABASE_URL=
# Preferred for browser clients. Legacy VITE_SUPABASE_ANON_KEY remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
