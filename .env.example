# Home Services WhatsApp Chatbot — environment variables.
#
# Backend vars below go in api/.env (the Express server's working directory).
# Frontend vars (VITE_*) go in a .env file at the repo root, next to
# vite.config.js — Vite only exposes VITE_-prefixed vars to client code.
# Never commit either real .env file.

# ── AI (Google Gemini) ─────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional stronger model, used only when the primary model fails or answers
# with very low confidence. Empty = no second call.
GEMINI_FALLBACK_MODEL=
# Image review for complaint photos (describes what is visible; never
# diagnoses). Off = every photo is attached as is.
IMAGE_ANALYSIS_ENABLED=false
IMAGE_MAX_FILE_SIZE_MB=5

# ── Message-cost analytics (estimates shown on the owner dashboard) ─────────
COST_PER_AI_CALL=0.0003
COST_PER_TEMPLATE_MESSAGE=0.0157
COST_PER_SESSION_MESSAGE=0
COST_CURRENCY=USD

# ── Conversation behaviour ─────────────────────────────────────────────────
# An unfinished booking is offered for resuming when the customer returns
# within this many hours. The bot never messages first about it.
DRAFT_RESUME_HOURS=72
# Cross-selling after a booking ("Add Pest Control"). Off unless the client
# wants it. SERVICE_BUNDLES overrides the pairs, e.g.
# {"home_cleaning":["pest_control"]} (keys: api/ai/serviceSynonyms.js).
SERVICE_BUNDLES_ENABLED=false
SERVICE_BUNDLES=

# ── Escalation SLA (bundled Supabase CRM only; on by default in production) ─
ESCALATION_SLA_MONITOR_ENABLED=
ESCALATION_SLA_INTERVAL_MINUTES=5
ESCALATION_SLA_URGENT_MINUTES=15
ESCALATION_SLA_HIGH_MINUTES=30
ESCALATION_SLA_NORMAL_MINUTES=120
# A handoff silences the bot for that customer until the escalation is
# resolved, the customer types "menu", or this many hours pass.
HUMAN_TAKEOVER_MAX_HOURS=24

# ── WhatsApp Cloud API ───────────────────────────────────────────────────
# New names. WHATSAPP_TOKEN / VERIFY_TOKEN (the pre-refactor names) still work
# as fallbacks during the transition — see api/config/env.js.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (App Dashboard > Settings > Basic). Every webhook POST is
# verified against X-Hub-Signature-256. Required in production: without it
# the webhook answers 503 and Meta keeps retrying until it is set.
WHATSAPP_APP_SECRET=

# Approved message templates for business-initiated messages. WhatsApp only
# delivers templates outside the 24-hour customer-service window; a lifecycle
# message with no template configured is skipped (and logged) rather than sent
# and silently dropped. Expected template bodies: see api/crm/HTTP_CRM_CONTRACT.md.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_BOOKING_ASSIGNED=
WHATSAPP_TEMPLATE_TECHNICIAN_ON_THE_WAY=
WHATSAPP_TEMPLATE_FEEDBACK_REQUEST=

# ── Client CRM ──────────────────────────────────────────────────────────
# supabase = built-in Supabase-backed CRM adapter (default)
# http     = the client's CRM over HTTPS (api/crm/httpCrmAdapter.js). The REST
#            contract it expects is in api/crm/HTTP_CRM_CONTRACT.md.
CRM_PROVIDER=supabase
CLIENT_API_BASE_URL=
CLIENT_API_KEY=
# "Authorization" sends "Bearer <key>"; any other header name sends the raw key.
CLIENT_API_AUTH_HEADER=Authorization
# Optional JSON overriding endpoint paths, e.g. {"createBookings":"/v2/bookings/bulk"}
CLIENT_API_ENDPOINTS=

# Booking lifecycle events pushed by the CRM to POST /api/crm/events
# (technician assigned / on the way / job completed). Requests are accepted
# with X-CRM-Signature: sha256=HMAC(secret, body) or Authorization: Bearer
# <secret>. Unset = endpoint disabled.
CRM_WEBHOOK_SECRET=
# A post-job feedback request stays answerable this many hours.
FEEDBACK_REQUEST_TTL_HOURS=72

# ── Scheduling ──────────────────────────────────────────────────────────
# "today", past-slot filtering and slot timestamps use this timezone.
BUSINESS_TIMEZONE=Asia/Dubai
# How many days ahead the booking flow lists dates that have open slots.
BOOKING_DATE_WINDOW_DAYS=7

# ── Locations, addresses and service area ───────────────────────────────
# none | google | nominatim. google is recommended (Indian PIN codes and
# localities; also looks up typed addresses). Enable the Geocoding API on the
# key and restrict the key to that API.
GEOCODING_PROVIDER=none
GOOGLE_MAPS_API_KEY=
# Search typed addresses only in this country (ISO code, e.g. IN).
GEOCODING_COUNTRY=
# Bundled Supabase CRM only (a client CRM decides through its own
# serviceability endpoint). Empty = everywhere is serviceable.
# PIN codes, exact or prefix with *: 682030,682042,6820*
SERVICEABLE_PINCODES=
# Cities/localities, used when a location has no PIN code: Kochi,Kakkanad
SERVICEABLE_CITIES=
# City saved on new addresses when geocoding found none.
DEFAULT_CITY=
# Emergency number in safety guidance (gas smell, sparks): 112 India, 997 UAE.
EMERGENCY_PHONE_NUMBER=112
# Nominatim's usage policy requires identifying yourself; also set
# NOMINATIM_BASE_URL for a self-hosted or commercial instance.
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_BASE_URL=
GEOCODING_TIMEOUT_MS=5000

# ── Chatbot reliability ─────────────────────────────────────────────────
CRM_REQUEST_TIMEOUT_MS=10000
AI_REQUEST_TIMEOUT_MS=10000
WHATSAPP_REQUEST_TIMEOUT_MS=10000
SESSION_TTL_MINUTES=60
MAX_READ_RETRIES=2
WHATSAPP_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=250
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_COOLDOWN_MS=30000

# Cross-instance coordination: postgres (default in production) shares locks,
# message ordering and duplicate-booking protection between instances through
# the reliability migration; memory is single-process only.
COORDINATION_BACKEND=
CONVERSATION_LOCK_TTL_MS=30000
CONVERSATION_LOCK_WAIT_MS=20000

# ── WhatsApp voice notes ────────────────────────────────────────────────
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_MAX_FILE_SIZE_MB=10
VOICE_TRANSCRIPTION_TIMEOUT_MS=20000
VOICE_MIN_CONFIDENCE=0.55

# ── Voice-data privacy and retention ────────────────────────────────────
# false = the message log keeps "[voice note]" instead of the transcript.
STORE_VOICE_TRANSCRIPTS=true
# Mask card numbers, Emirates ID and IBANs in transcripts before storage/AI.
REDACT_SENSITIVE_DATA=true
VOICE_TRANSCRIPT_RETENTION_DAYS=90
VOICE_MEDIA_RETENTION_DAYS=30
CHATBOT_STATE_RETENTION_DAYS=30
# Daily retention job (defaults to on in production).
RETENTION_JOB_ENABLED=
RETENTION_JOB_INTERVAL_HOURS=24

# ── Supabase (datastore for sessions/customers/bookings/complaints/etc.) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only, never expose to the browser. Falls back to
# SUPABASE_ANON_KEY when unset. Set this before enabling RLS, otherwise the
# webhook loses access to every table.
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Authorized developer test console ───────────────────────────────────
# Both values are required. Send the secret in the x-test-chat-secret header.
ENABLE_TEST_CHAT=false
TEST_CHAT_SECRET=

# Optional public-review invitation after feedback is stored. The chatbot
# never submits a review; it only shares this configured URL when enabled.
REVIEWS_ENABLED=false
PUBLIC_REVIEW_URL=
REVIEW_MIN_RATING=4

# Stable server-side salt for pseudonymous phone hashes in chatbot analytics.
# Without it the service-role key is used as the salt.
ANALYTICS_HASH_SALT=

# ── Frontend dashboard (root .env, not api/.env — Vite requires VITE_ prefix) ─
VITE_SUPABASE_URL=
# Preferred for browser clients. Legacy VITE_SUPABASE_ANON_KEY remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
